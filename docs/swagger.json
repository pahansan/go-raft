{
    "swagger": "2.0",
    "info": {
        "title": "Go Raft API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/add-entries": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "client"
                ],
                "summary": "Добавить записи в лог",
                "parameters": [
                    {
                        "description": "Команда или пакет команд",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.AddEntriesRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.AddEntriesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.AddEntriesResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/main.AddEntriesResponse"
                        },
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "http://\u003cleader\u003e/add-entries"
                            }
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "$ref": "#/definitions/main.AddEntriesResponse"
                        }
                    }
                }
            }
        },
        "/append-entries": {
            "post": {
                "description": "Лидер реплицирует записи лога и передаёт commitIndex, либо heartbeat.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "raft"
                ],
                "summary": "AppendEntries RPC",
                "parameters": [
                    {
                        "description": "Запрос репликации",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.AppendEntriesRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.AppendEntriesResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректный JSON",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/request-vote": {
            "post": {
                "description": "Кандидат запрашивает голос у узла.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "raft"
                ],
                "summary": "RequestVote RPC",
                "parameters": [
                    {
                        "description": "Запрос голоса",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.VoteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.VoteResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректный JSON",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/show-log": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "client"
                ],
                "summary": "Показать лог узла",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.ShowLogResponse"
                        }
                    }
                }
            }
        },
        "/status": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cluster"
                ],
                "summary": "Статус узла",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.StatusResponse"
                        }
                    }
                }
            }
        }
    },
