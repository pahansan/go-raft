            "type": "object",
            "properties": {
                "command": {},
                "entries": {
                    "type": "array",
                    "items": {}
                }
            }
        },
        "main.AddEntriesResponse": {
            "type": "object",
            "properties": {
                "committed": {
                    "type": "boolean"
                },
                "error": {
                    "type": "string"
                },
                "indexes": {
                    "type": "array",
