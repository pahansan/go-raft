        },
        "main.AppendEntriesResponse": {
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "term": {
                    "type": "integer"
                }
            }
        },
        "main.LogEntry": {
            "type": "object",
            "properties": {
                "command": {},
                "index": {
                    "type": "integer"
                },
                "term": {
                    "type": "integer"
                }
            }
        },
        "main.LogEntryView": {
            "type": "object",
            "properties": {
                "applied": {
                    "type": "boolean"
                },
                "command": {},
                "committed": {
                    "type": "boolean"
                },
